<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Tes komponen Blazor (bUnit). Tidak membutuhkan Docker, browser, atau API. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Frontend\Gms.Web\Gms.Web.csproj" />
    <ProjectReference Include="..\..\Shared\Gms.Shared\Gms.Shared.csproj" />
  </ItemGroup>

</Project>
