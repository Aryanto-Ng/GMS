<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Blazor Web App. Interactive Server untuk hampir semua halaman, Static SSR untuk Login/Logout/Ganti Password/403. -->

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Fluent UI (MIT). Versi terpusat di Directory.Packages.props. -->
    <PackageReference Include="AntDesign" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web HANYA mereferensi Shared (kontrak). Tidak boleh mereferensi Api/Domain/Infrastructure. -->
    <ProjectReference Include="..\..\Shared\Gms.Shared\Gms.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gms.Web.Tests" />
  </ItemGroup>

</Project>
