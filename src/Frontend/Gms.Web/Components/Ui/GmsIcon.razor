@* Ikon SVG dekoratif (aria-hidden) dari set GmsIcons. Ikon bermakna wajib disertai teks atau aria-label pada pemiliknya. *@
<svg class="gms-icon @Class" viewBox="0 0 16 16" aria-hidden="true" focusable="false" data-icon="@GmsIcons.Resolve(Name)"><path d="@GmsIcons.PathFor(Name)" /></svg>

@code {
    /// <summary>Nama ikon (lihat <see cref="GmsIcons"/>); alias nama AntDesign diterima.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "info";

    /// <summary>Kelas tambahan: s12, s20, s32.</summary>
    [Parameter] public string? Class { get; set; }
}
