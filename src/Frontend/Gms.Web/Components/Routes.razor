<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(NotFoundPage)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @* Interaktif: tampilkan 403 di dalam shell tanpa memuat ulang. *@
                <ForbiddenContent />
            </NotAuthorized>
            <Authorizing>
                <div class="gms-boot" role="status" aria-live="polite">Memuat…</div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
