<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css"]" />
    @* AntDesign Blazor: stylesheet terang (variabel palet) dan gelap resmi; theme-init.js memilih salah satu sebelum render pertama. *@
    <link id="ant-light" rel="stylesheet" href="@Assets["_content/AntDesign/css/ant-design-blazor.variable.css"]" />
    <link id="ant-dark" rel="stylesheet" href="@Assets["_content/AntDesign/css/ant-design-blazor.dark.css"]" media="not all" />
    <script src="@Assets["js/theme-init.js"]"></script>
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/ant-theme.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/shell.css"]" />
    <link rel="stylesheet" href="@Assets["Gms.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <AntDesign.AntContainer @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/AntDesign/js/ant-design-blazor.js"]"></script>
    <script src="@Assets["js/shell.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Halaman bertanda [ExcludeFromInteractiveRouting] (login, ganti password, 403) tetap Static SSR; selebihnya Interactive Server.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext is not null && HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
