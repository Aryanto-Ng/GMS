<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Gms.Web.styles.css"]" />
    <ImportMap nonce="@Nonce" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/shell.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Nonce CSP per permintaan (SecurityHeaders): satu-satunya skrip inline adalah import map yang dihasilkan framework.
    private string? Nonce => HttpContext?.Items[Gms.Web.Infrastructure.SecurityHeaders.NonceItemKey] as string;

    // Halaman bertanda [ExcludeFromInteractiveRouting] (login, ganti password, 403) tetap Static SSR; selebihnya Interactive Server.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext is not null && HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
