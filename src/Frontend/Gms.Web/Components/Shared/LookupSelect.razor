@* Pilihan dari daftar lookup (hanya master aktif). Satu opsi kosong bila tidak wajib. *@
<div class="gms-form">
    <label for="@_id">@Label @if (Required) { <span class="gms-required">wajib</span> }</label>
    <select id="@_id" disabled="@Disabled" @onchange="OnChange">
        <option value="">@Placeholder</option>
        @foreach (var item in Items)
        {
            <option value="@item.Id" selected="@(Value == item.Id)">@(ShowCode ? $"{item.Code} · {item.Name}" : item.Name)</option>
        }
    </select>
</div>

@code {
    private static int _counter;
    private readonly string _id = $"gms-ls-{Interlocked.Increment(ref _counter)}";

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public IReadOnlyList<LookupItem> Items { get; set; } = [];

    [Parameter] public Guid? Value { get; set; }

    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ShowCode { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Pilih…";

    private Task OnChange(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);
}
