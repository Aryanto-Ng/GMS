@* Paging server (_Foundation-UI.md 4.1): "x–y dari z", sebelumnya/berikutnya. Tombol dinonaktifkan di tepi dan saat memuat. *@
<nav class="gms-pager" aria-label="Halaman data">
    <span aria-live="polite">@Summary</span>
    <div class="gms-pager-buttons">
        <AntDesign.Button Type="@AntDesign.ButtonType.Default" Disabled="@(!HasPrevious || Busy)" OnClick="() => Go(Page - 1)" AriaLabel="Halaman sebelumnya">Sebelumnya</AntDesign.Button>
        <span class="gms-pager-page">Halaman @Page dari @PageCount</span>
        <AntDesign.Button Type="@AntDesign.ButtonType.Default" Disabled="@(!HasNext || Busy)" OnClick="() => Go(Page + 1)" AriaLabel="Halaman berikutnya">Berikutnya</AntDesign.Button>
    </div>
</nav>

@code {
    [Parameter] public int Page { get; set; } = 1;

    [Parameter] public int PageSize { get; set; } = 25;

    [Parameter] public int TotalCount { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<int> PageChanged { get; set; }

    public int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)Math.Max(1, PageSize)));

    public bool HasPrevious => Page > 1;

    public bool HasNext => Page < PageCount;

    public string Summary => TotalCount == 0
        ? "Tidak ada data"
        : $"{IdFormat.Qty((Page - 1) * PageSize + 1)}–{IdFormat.Qty(Math.Min(Page * PageSize, TotalCount))} dari {IdFormat.Qty(TotalCount)}";

    private Task Go(int page) => PageChanged.InvokeAsync(Math.Clamp(page, 1, PageCount));
}
