@* Chip status (_Foundation-UI.md 5.2). SELALU ikon + teks (tidak hanya warna). *@
@{
    var p = StatusPresentation.For(Value);
}
<span class="gms-chip @p.Tone @(p.Strike ? "strike" : string.Empty)" title="@(Tooltip ?? p.Tooltip)">
    <FluentIcon Value="@p.Icon" Color="Color.Neutral" />
    <span>@p.Label</span>
</span>

@code {
    /// <summary>Enum status (PoStatus, WoStatus, DocStatus, PayrollStatus) atau kunci teks: late, provisional, ready, not-ready, active, inactive.</summary>
    [Parameter, EditorRequired] public object? Value { get; set; }

    [Parameter] public string? Tooltip { get; set; }
}
