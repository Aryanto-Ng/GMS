@implements IAsyncDisposable
@inject IJSRuntime JS

@* Grid Matriks Ukuran Color × Size (_Foundation-UI.md 5.1). Dipakai di PO, WO, Output, Serah Terima, Vendor, Pengiriman, Tarif.
   Keyboard: Tab antar sel, Enter turun, panah, Home/End, Ctrl+V tempel blok dari Excel (ditangani modul JS kecil; logika di C#). *@
<div class="gms-matrix-wrap" @ref="_root">
    <table class="gms-matrix @(Compact ? "compact" : string.Empty)">
        <caption>@Caption</caption>
        <thead>
            <tr>
                <th scope="col" class="gms-matrix-rowhead">@RowHeader</th>
                @foreach (var column in Columns)
                {
                    <th scope="col" class="num">@column.Label</th>
                }
                <th scope="col" class="num gms-matrix-total">Total</th>
            </tr>
        </thead>
        <tbody>
            @for (var ri = 0; ri < Rows.Count; ri++)
            {
                var row = Rows[ri];
                <tr>
                    <th scope="row" class="gms-matrix-rowhead">
                        @row.Label
                        @if (!string.IsNullOrEmpty(row.SubLabel)) { <small>@row.SubLabel</small> }
                    </th>
                    @for (var ci = 0; ci < Columns.Count; ci++)
                    {
                        var column = Columns[ci];
                        var info = Info(row.Key, column.Key);
                        var value = Values.Get(row.Key, column.Key);
                        var issue = _issues.FirstOrDefault(i => i.RowKey == row.Key && i.ColumnKey == column.Key);
                        var name = $"{row.Label}, Size {column.Label}";
                        var messageId = $"{_id}-msg-{ri}-{ci}";
                        <td class="num gms-cell @(issue is null ? string.Empty : issue.IsError ? "error" : "warning") @(info.Enabled ? string.Empty : "disabled")">
                            @if (!info.Enabled)
                            {
                                <span class="gms-na" aria-label="@($"{name}: tidak berlaku")">—</span>
                            }
                            else if (ReadOnly)
                            {
                                <span class="@(value < 0 ? "gms-negative" : string.Empty)">@IdFormat.Qty(value)</span>
                            }
                            else
                            {
                                <input type="text" inputmode="numeric" autocomplete="off" data-r="@ri" data-c="@ci"
                                       id="@($"{_id}-{ri}-{ci}")" aria-label="@name"
                                       aria-invalid="@(issue?.IsError == true ? "true" : null)"
                                       aria-describedby="@(issue is null ? null : messageId)"
                                       value="@(value?.ToString())" @oninput="e => OnInputAsync(row.Key, column.Key, e)" />
                            }

                            @if (ShowMax && info.Enabled)
                            {
                                <div class="gms-cellmax">@(info.Max is { } m ? $"maks {IdFormat.Qty(m)}" : "tanpa batas")</div>
                            }

                            @if (issue is not null)
                            {
                                <div class="gms-cellmsg @(issue.IsError ? "error" : "warning")" id="@messageId">
                                    <AntDesign.Icon Type="@(issue.IsError ? "close-circle" : "warning")" />
                                    @(issue.IsError ? "melebihi batas" : "melebihi Qty WO")
                                </div>
                            }
                        </td>
                    }
                    <td class="num gms-matrix-total"><strong>@IdFormat.Qty(SizeMatrixLogic.RowTotal(Values, row.Key, Columns, Info))</strong></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th scope="row" class="gms-matrix-rowhead">Total</th>
                @foreach (var column in Columns)
                {
                    <td class="num"><strong>@IdFormat.Qty(SizeMatrixLogic.ColumnTotal(Values, column.Key, Rows, Info))</strong></td>
                }
                <td class="num gms-matrix-total"><strong>@IdFormat.Qty(GrandTotal)</strong></td>
            </tr>
        </tfoot>
    </table>
    <p class="gms-sr-only" role="status" aria-live="polite">@_pasteNote</p>
</div>

@code {
    private static int _counter;
    private readonly string _id = $"gms-matrix-{Interlocked.Increment(ref _counter)}";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<QtyGrid>? _self;
    private IReadOnlyList<MatrixIssue> _issues = [];
    private string _pasteNote = string.Empty;

    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;

    [Parameter] public string RowHeader { get; set; } = "Color";

    [Parameter, EditorRequired] public IReadOnlyList<MatrixRow> Rows { get; set; } = [];

    /// <summary>Kolom Size menurut Urutan Tampil master Size (urutan diatur pemanggil).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<MatrixColumn> Columns { get; set; } = [];

    [Parameter, EditorRequired] public MatrixValues Values { get; set; } = new();

    /// <summary>Aturan per sel (berlaku, batas keras, batas lunak). Bila null: semua sel berlaku tanpa batas.</summary>
    [Parameter] public Func<string, string, MatrixCellInfo>? CellInfo { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Menampilkan baris kecil "maks N" di bawah tiap sel.</summary>
    [Parameter] public bool ShowMax { get; set; }

    [Parameter] public bool Compact { get; set; } = true;

    /// <summary>Dipanggil setiap nilai berubah (ketik atau tempel).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Isu batas saat ini (galat keras dan peringatan lunak).</summary>
    public IReadOnlyList<MatrixIssue> Issues => _issues;

    public bool HasErrors => _issues.Any(i => i.IsError);

    public int GrandTotal => Rows.Sum(r => SizeMatrixLogic.RowTotal(Values, r.Key, Columns, Info));

    private MatrixCellInfo Info(string row, string column) => CellInfo?.Invoke(row, column) ?? new MatrixCellInfo();

    protected override void OnParametersSet() => _issues = SizeMatrixLogic.Evaluate(Rows, Columns, Values, Info);

    private async Task OnInputAsync(string row, string column, ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).Take(7).ToArray());
        Values.Set(row, column, digits.Length == 0 ? null : int.Parse(digits));
        _issues = SizeMatrixLogic.Evaluate(Rows, Columns, Values, Info);
        await OnChanged.InvokeAsync();
    }

    /// <summary>Dipanggil modul JS saat pengguna menempel teks berisi tab/newline (blok dari Excel).</summary>
    [JSInvokable]
    public async Task PasteAsync(int startRow, int startCol, string text)
    {
        var (applied, skipped) = SizeMatrixLogic.Paste(Rows, Columns, Values, Info, startRow, startCol, text);
        _pasteNote = skipped == 0 ? $"{applied} sel ditempel." : $"{applied} sel ditempel, {skipped} dilewati (bukan angka bulat atau sel tidak berlaku).";
        _issues = SizeMatrixLogic.Evaluate(Rows, Columns, Values, Info);
        await OnChanged.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !ReadOnly)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/QtyGrid.razor.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _root, _self);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // sirkuit sudah tertutup
            }
        }
    }
}
