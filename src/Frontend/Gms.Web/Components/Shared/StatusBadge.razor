@* StatusBadge (Design.md 8): SELALU teks (ikon opsional) + warna dari peta 6 kategori di StatusPresentation; status tidak pernah hanya warna. *@
@{
    var p = StatusPresentation.For(Value);
}
<span class="gms-tag @p.Tone @(p.Strike ? "strike" : string.Empty)" title="@(Tooltip ?? p.Tooltip)">
    @if (p.Icon is not null)
    {
        <GmsIcon Name="@p.Icon" />
    }
    <span>@p.Label</span>
</span>

@code {
    /// <summary>Enum status (PoStatus, WoStatus, DocStatus, PayrollStatus) atau kunci teks: late, due-soon, no-number, negative, provisional, ready, not-ready, active, inactive.</summary>
    [Parameter, EditorRequired] public object? Value { get; set; }

    [Parameter] public string? Tooltip { get; set; }
}
