@* Penjaga perubahan belum tersimpan (Design.md 6): menandai TAB dengan titik oranye selama ada perubahan (menutup tab meminta konfirmasi di TabBar).
   Berpindah tab tidak kehilangan data karena halaman tetap hidup, jadi navigasi internal TIDAK dikonfirmasi; menutup/memuat ulang browser tetap dikonfirmasi. *@
<NavigationLock ConfirmExternalNavigation="HasChanges" />

@code {
    [CascadingParameter] private TabContext? Tab { get; set; }

    [Parameter] public bool HasChanges { get; set; }

    [Parameter] public string Message { get; set; } = "Perubahan belum disimpan akan hilang. Tinggalkan halaman ini?";

    protected override void OnParametersSet() => Tab?.SetDirty(HasChanges);
}
