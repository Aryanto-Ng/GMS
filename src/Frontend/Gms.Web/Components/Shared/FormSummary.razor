@* Ringkasan galat form (_Foundation-UI.md 4.2): fokus berpindah ke sini saat Simpan gagal; tiap item menaut ke field-nya. *@
@inject IJSRuntime JS

@if (Errors is { Count: > 0 })
{
    <div class="gms-banner error gms-formsummary" role="alert" tabindex="-1" @ref="_root" aria-labelledby="gms-formsummary-title">
        <div class="gms-banner-body">
            <strong id="gms-formsummary-title">@Title</strong>
            <ul>
                @foreach (var (path, messages) in Errors)
                {
                    foreach (var message in messages)
                    {
                        <li><a href="#@FieldId(path)">@Label(path)</a>: @message</li>
                    }
                }
            </ul>
        </div>
    </div>
}

@code {
    private ElementReference _root;
    private int _lastCount = -1;

    [Parameter] public IReadOnlyDictionary<string, string[]>? Errors { get; set; }

    [Parameter] public string Title { get; set; } = "Data belum valid. Periksa isian berikut:";

    /// <summary>Nama tampil per path (mis. "customerId" → "Customer"); bila tidak ada, path ditampilkan apa adanya.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? Labels { get; set; }

    /// <summary>Id elemen field untuk path validasi: <c>lines[0].qty</c> → <c>field-lines-0-qty</c>.</summary>
    public static string FieldId(string path) =>
        "field-" + new string(path.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray()).Trim('-').Replace("--", "-");

    private string Label(string path) => Labels is not null && Labels.TryGetValue(path, out var label) ? label : path;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var count = Errors?.Sum(e => e.Value.Length) ?? 0;
        if (count > 0 && count != _lastCount)
        {
            _lastCount = count;
            await _root.FocusAsync();
        }
        else if (count == 0)
        {
            _lastCount = -1;
        }
    }
}
