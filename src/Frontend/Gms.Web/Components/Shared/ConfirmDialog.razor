@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiErrorHandler Errors

@* ConfirmDialog (Design.md 8.8) di atas AntDesign <Modal>: alasan WAJIB + pratinjau dampak untuk Void, Koreksi, Cancel, Reopen, Penyesuaian,
   Pelepasan alokasi, Tutup Periode. Esc (ditangani modul JS, bukan Modal) dan tombol tutup diblok saat memproses; klik latar tidak menutup (aksi berisiko). Isi hanya dirender saat
   terbuka dan state direset pada setiap pembukaan. JANGAN memakai DestroyOnClose (membuat DOM dirender ulang terus pada pembukaan kedua). aria-labelledby/-describedby/-modal dipasang modul JS karena Modal tidak menyediakannya. *@
<AntDesign.Modal Visible="Open" Width="640" Closable="@(!_busy)" Keyboard="false" MaskClosable="false"
                 WrapClassName="gms-dialog-wrap" OnCancel="CancelAsync" Footer="FooterContent">
    <TitleTemplate><h2 id="@_titleId" class="gms-dialog-title">@Title</h2></TitleTemplate>
    <ChildContent>
        @if (Open)
        {
            <div class="gms-dialog-body" aria-busy="@(_busy ? "true" : "false")">
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p id="@_descId">@Description</p>
                }

                @ChildContent

                @if (LoadPreview is not null)
                {
                    @if (_previewLoading)
                    {
                        <SkeletonRows Rows="3" Columns="4" Label="Menghitung dampak" />
                    }
                    else if (_previewProblem is not null)
                    {
                        <ProblemBanner Problem="_previewProblem" OnReload="LoadPreviewAsync" />
                    }
                    else
                    {
                        <ImpactPreviewTable Preview="_preview" />
                    }
                }

                @if (ShowReason)
                {
                    <label for="@_reasonId">Alasan @(ReasonRequired ? "" : "(opsional)") @if (ReasonRequired) { <span class="gms-required">wajib</span> }</label>
                    <textarea id="@_reasonId" class="gms-reason" rows="3" maxlength="@MaxLength" autofocus
                              aria-describedby="@(_reasonId)-hint" value="@_reason" @oninput="e => _reason = e.Value?.ToString() ?? string.Empty"></textarea>
                    <small id="@(_reasonId)-hint">@_reason.Length / @MaxLength karakter</small>
                }

                @if (_problem is not null)
                {
                    <ProblemBanner Problem="_problem" />
                }
            </div>
        }
    </ChildContent>
</AntDesign.Modal>

@code {
    private static int _counter;
    private readonly string _titleId = $"gms-dlg-title-{Interlocked.Increment(ref _counter)}";
    private string _descId => _titleId.Replace("title", "desc");
    private string _reasonId => _titleId.Replace("title", "reason");

    private IJSObjectReference? _module;
    private DotNetObjectReference<ConfirmDialog>? _self;
    private bool _wasOpen;
    private bool _busy;
    private string _reason = string.Empty;
    private GmsProblemDetails? _problem;
    private ImpactPreview? _preview;
    private bool _previewLoading;
    private GmsProblemDetails? _previewProblem;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Description { get; set; }

    [Parameter] public string ConfirmText { get; set; } = "Ya, lanjutkan";

    /// <summary>Aksi destruktif: tombol utama berwarna bahaya.</summary>
    [Parameter] public bool Danger { get; set; } = true;

    [Parameter] public bool ReasonRequired { get; set; } = true;

    /// <summary>false = dialog konfirmasi biasa tanpa isian alasan (OnConfirm menerima string kosong).</summary>
    [Parameter] public bool ShowReason { get; set; } = true;

    [Parameter] public int MaxLength { get; set; } = 500;

    /// <summary>Syarat tambahan dari pemanggil (mis. konfirmasi kode periode).</summary>
    [Parameter] public bool CanConfirm { get; set; } = true;

    /// <summary>Memuat pratinjau dampak dari server (jalur kode yang sama dengan eksekusi). Bila melanggar, tombol utama nonaktif.</summary>
    [Parameter] public Func<CancellationToken, Task<ImpactPreview>>? LoadPreview { get; set; }

    /// <summary>Eksekusi aksi. Melempar <see cref="ApiException"/> menampilkan penahan di dalam dialog tanpa menutupnya.</summary>
    [Parameter, EditorRequired] public Func<string, Task> OnConfirm { get; set; } = _ => Task.CompletedTask;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool ReasonOk => !ShowReason || !ReasonRequired || !string.IsNullOrWhiteSpace(_reason);

    private bool PreviewOk => LoadPreview is null || (_preview is { CanProceed: true } && !_previewLoading);

    public bool CanSubmit => !_busy && ReasonOk && CanConfirm && PreviewOk;

    protected override async Task OnParametersSetAsync()
    {
        if (!Open)
        {
            _wasOpen = false;
            return;
        }

        if (!_wasOpen)
        {
            _wasOpen = true;
            _reason = string.Empty;
            _problem = null;
            _preview = null;
            _previewProblem = null;
            if (LoadPreview is not null)
            {
                await LoadPreviewAsync();
            }
        }
    }

    private async Task LoadPreviewAsync()
    {
        if (LoadPreview is null)
        {
            return;
        }

        _previewLoading = true;
        _previewProblem = null;
        StateHasChanged();
        _previewProblem = await Errors.RunAsync(async () => _preview = await LoadPreview(CancellationToken.None));
        _previewLoading = false;
    }

    /// <summary>Tombol di footer Modal: [Batal] dan tombol utama (Danger/Loading/Disabled sesuai keadaan).</summary>
    private RenderFragment FooterContent => builder =>
    {
        builder.OpenComponent<AntDesign.Button>(0);
        builder.AddAttribute(1, "Type", AntDesign.ButtonType.Default);
        builder.AddAttribute(2, "Disabled", _busy);
        builder.AddAttribute(3, "OnClick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, _ => CancelAsync()));
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, "Batal")));
        builder.CloseComponent();

        builder.OpenComponent<AntDesign.Button>(5);
        builder.AddAttribute(6, "Type", AntDesign.ButtonType.Primary);
        builder.AddAttribute(7, "Danger", Danger);
        builder.AddAttribute(8, "Loading", _busy);
        builder.AddAttribute(9, "Disabled", !CanSubmit);
        builder.AddAttribute(10, "OnClick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, _ => SubmitAsync()));
        builder.AddAttribute(11, "ChildContent", (RenderFragment)(b => b.AddContent(0, ConfirmText)));
        builder.CloseComponent();
    };

    /// <summary>
    /// Setiap render saat terbuka: pasang nama dan deskripsi aksesibel pada elemen role="dialog" (Modal tidak menyediakannya).
    /// Idempoten dan murah; tidak memakai AfterOpen karena tidak andal pada pembukaan berulang.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ConfirmDialog.razor.js");
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("label", _titleId, string.IsNullOrEmpty(Description) ? null : _descId, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // pelabelan bersifat tambahan; kegagalan JS tidak boleh menggagalkan dialog
        }
    }

    /// <summary>Dipanggil modul JS saat Esc ditekan di dalam dialog; diabaikan saat memproses.</summary>
    [JSInvokable]
    public async Task RequestClose()
    {
        if (!_busy)
        {
            await CancelAsync();
        }
    }

    private async Task CancelAsync()
    {
        if (_busy)
        {
            return;
        }

        await SetOpenAsync(false);
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        _busy = true;
        _problem = null;
        StateHasChanged();
        try
        {
            _problem = await Errors.RunAsync(() => OnConfirm(_reason.Trim()));
            if (_problem is null)
            {
                await SetOpenAsync(false);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetOpenAsync(bool value)
    {
        Open = value;
        if (!value)
        {
            _wasOpen = false; // pembukaan berikutnya (walau sangat cepat) selalu mereset isian, pratinjau, dan galat
        }

        StateHasChanged(); // Modal harus melihat Visible=false sebelum induk merender ulang
        await OpenChanged.InvokeAsync(value);
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // sirkuit sudah tertutup
            }
        }
    }
}
