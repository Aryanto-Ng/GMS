@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiErrorHandler Errors

@* Dialog (Design.md 10): 480px, radius 8px, latar gelap 40%; varian lebar 720px (Wide) HANYA untuk pratinjau dampak (U-1). Alasan WAJIB + pratinjau dampak untuk
   Void, Koreksi, Cancel, Reopen, Penyesuaian, Pelepasan alokasi, Tutup Periode. Esc dan fokus terkurung ditangani modul JS (diblok saat memproses); klik latar tidak menutup
   (aksi berisiko). Isi hanya dirender saat terbuka dan state direset pada setiap pembukaan. *@
@if (Open)
{
    <div class="gms-dialog-wrap" @ref="_wrap">
        <div class="gms-dialog @(Wide || LoadPreview is not null ? "wide" : "")" role="dialog" aria-modal="true" aria-labelledby="@_titleId" aria-describedby="@(string.IsNullOrEmpty(Description) ? null : _descId)" tabindex="-1">
            <div class="gms-dialog-header">
                <h2 id="@_titleId" class="gms-dialog-title">@Title</h2>
                <button type="button" class="gms-dialog-close" aria-label="Tutup" disabled="@_busy" @onclick="CancelAsync"><GmsIcon Name="dismiss" /></button>
            </div>
            <div class="gms-dialog-body" aria-busy="@(_busy ? "true" : "false")">
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p id="@_descId">@Description</p>
                }

                @ChildContent

                @if (LoadPreview is not null)
                {
                    @if (_previewLoading)
                    {
                        <SkeletonRows Rows="3" Columns="4" Label="Menghitung dampak" />
                    }
                    else if (_previewProblem is not null)
                    {
                        <ProblemBanner Problem="_previewProblem" OnReload="LoadPreviewAsync" />
                    }
                    else
                    {
                        <ImpactPreviewTable Preview="_preview" />
                    }
                }

                @if (ShowReason)
                {
                    <label for="@_reasonId">Alasan @(ReasonRequired ? "" : "(opsional)") @if (ReasonRequired) { <span class="gms-required">wajib</span> }</label>
                    <textarea id="@_reasonId" class="gms-reason" rows="3" maxlength="@MaxLength"
                              aria-describedby="@(_reasonId)-hint" value="@_reason" @oninput="e => _reason = e.Value?.ToString() ?? string.Empty"></textarea>
                    <small id="@(_reasonId)-hint">@_reason.Length / @MaxLength karakter</small>
                }

                @if (_problem is not null)
                {
                    <ProblemBanner Problem="_problem" />
                }
            </div>
            <div class="gms-dialog-footer">
                <GmsButton Type="BtnKind.Default" Disabled="_busy" OnClick="() => CancelAsync()">@CancelText</GmsButton>
                <GmsButton Type="BtnKind.Primary" Danger="Danger" Loading="_busy" Disabled="!CanSubmit" OnClick="() => SubmitAsync()">@ConfirmText</GmsButton>
            </div>
        </div>
    </div>
}

@code {
    private static int _counter;
    private readonly string _titleId = $"gms-dlg-title-{Interlocked.Increment(ref _counter)}";
    private string _descId => _titleId.Replace("title", "desc");
    private string _reasonId => _titleId.Replace("title", "reason");

    private ElementReference _wrap;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ConfirmDialog>? _self;
    private bool _wasOpen;
    private bool _attached;
    private bool _busy;
    private string _reason = string.Empty;
    private GmsProblemDetails? _problem;
    private ImpactPreview? _preview;
    private bool _previewLoading;
    private GmsProblemDetails? _previewProblem;

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Description { get; set; }

    [Parameter] public string ConfirmText { get; set; } = "Ya, lanjutkan";

    [Parameter] public string CancelText { get; set; } = "Batal";

    /// <summary>Aksi destruktif: tombol utama berwarna bahaya.</summary>
    [Parameter] public bool Danger { get; set; } = true;

    [Parameter] public bool ReasonRequired { get; set; } = true;

    /// <summary>false = dialog konfirmasi biasa tanpa isian alasan (OnConfirm menerima string kosong).</summary>
    [Parameter] public bool ShowReason { get; set; } = true;

    [Parameter] public int MaxLength { get; set; } = 500;

    /// <summary>Dialog lebar 720px (pratinjau dampak). Otomatis lebar bila <see cref="LoadPreview"/> terisi.</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>Syarat tambahan dari pemanggil (mis. konfirmasi kode periode).</summary>
    [Parameter] public bool CanConfirm { get; set; } = true;

    /// <summary>Memuat pratinjau dampak dari server (jalur kode yang sama dengan eksekusi). Bila melanggar, tombol utama nonaktif.</summary>
    [Parameter] public Func<CancellationToken, Task<ImpactPreview>>? LoadPreview { get; set; }

    /// <summary>Eksekusi aksi. Melempar <see cref="ApiException"/> menampilkan penahan di dalam dialog tanpa menutupnya.</summary>
    [Parameter, EditorRequired] public Func<string, Task> OnConfirm { get; set; } = _ => Task.CompletedTask;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool ReasonOk => !ShowReason || !ReasonRequired || !string.IsNullOrWhiteSpace(_reason);

    private bool PreviewOk => LoadPreview is null || (_preview is { CanProceed: true } && !_previewLoading);

    public bool CanSubmit => !_busy && ReasonOk && CanConfirm && PreviewOk;

    protected override async Task OnParametersSetAsync()
    {
        if (!Open)
        {
            _wasOpen = false;
            return;
        }

        if (!_wasOpen)
        {
            _wasOpen = true;
            _reason = string.Empty;
            _problem = null;
            _preview = null;
            _previewProblem = null;
            if (LoadPreview is not null)
            {
                await LoadPreviewAsync();
            }
        }
    }

    private async Task LoadPreviewAsync()
    {
        if (LoadPreview is null)
        {
            return;
        }

        _previewLoading = true;
        _previewProblem = null;
        StateHasChanged();
        _previewProblem = await Errors.RunAsync(async () => _preview = await LoadPreview(CancellationToken.None));
        _previewLoading = false;
    }

    /// <summary>Saat dialog terbuka: pasang jebakan fokus + Esc (modul JS). Idempoten dan murah; kegagalan JS tidak menggagalkan dialog.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open)
        {
            if (_attached)
            {
                _attached = false;
                try
                {
                    if (_module is not null)
                    {
                        await _module.InvokeVoidAsync("detach");
                    }
                }
                catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
                {
                    // sirkuit tertutup atau modul belum termuat
                }
            }

            return;
        }

        if (_attached)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ConfirmDialog.razor.js");
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _wrap, _self);
            _attached = true;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // jebakan fokus bersifat tambahan; kegagalan JS tidak boleh menggagalkan dialog
        }
    }

    /// <summary>Dipanggil modul JS saat Esc ditekan di dalam dialog; diabaikan saat memproses.</summary>
    [JSInvokable]
    public async Task RequestClose()
    {
        if (!_busy)
        {
            await CancelAsync();
        }
    }

    private async Task CancelAsync()
    {
        if (_busy)
        {
            return;
        }

        await SetOpenAsync(false);
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        _busy = true;
        _problem = null;
        StateHasChanged();
        try
        {
            _problem = await Errors.RunAsync(() => OnConfirm(_reason.Trim()));
            if (_problem is null)
            {
                await SetOpenAsync(false);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetOpenAsync(bool value)
    {
        Open = value;
        if (!value)
        {
            _wasOpen = false; // pembukaan berikutnya (walau sangat cepat) selalu mereset isian, pratinjau, dan galat
        }

        StateHasChanged();
        await OpenChanged.InvokeAsync(value);
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // sirkuit sudah tertutup
            }
        }
    }
}
