@page "/notifications"
@inject INotificationsApi Api
@inject NotificationText Text
@inject IStringLocalizer<NotificationResource> L
@inject NavigationManager Nav
@inject ApiErrorHandler Errors
@inject IGmsToast Toast
@inject TimeProvider Time

<PageTitle>@L["Page.Title"] · GMS</PageTitle>

@* Semua notifikasi (Notifikasi-UI.md 3): pencarian wajib, chip kategori berjumlah, tabel terbaru dahulu, footer "Menampilkan X dari Y". Tanpa tombol primary. *@
<PageHeader Title="@L["Page.Title"]" TabTitle="@L["Panel.Title"]" Breadcrumbs="@Crumbs">
    <Actions>
        <GmsButton Icon="check" Disabled="@(_counts is null or { Unread: 0 })" OnClick="MarkAllAsync">@L["Panel.MarkAll"]</GmsButton>
    </Actions>
</PageHeader>

<div class="gms-card" style="padding:0">
    <form class="gms-toolbar" role="search" style="padding:var(--space-3) var(--space-4);margin:0;border-bottom:1px solid var(--s3)" @onsubmit="ApplySearch" @onsubmit:preventDefault>
        <div class="gms-field">
            <label for="n-q" class="gms-sr-only">@L["Page.Search"]</label>
            <input id="n-q" type="search" placeholder="@L["Page.Search"]" value="@_q" @oninput="e => _q = e.Value?.ToString() ?? string.Empty" />
        </div>
        <GmsButton HtmlType="submit">@L["Page.Search"]</GmsButton>
    </form>

    <div class="gms-chips" role="group" aria-label="Filter" style="padding:var(--space-2) var(--space-4) 0">
        <button type="button" class="gms-chipbtn @(_filter is null && !_unreadOnly ? "on" : "")" aria-pressed="@(_filter is null && !_unreadOnly ? "true" : "false")" @onclick="() => Select(null, false)">@L["Filter.All"] <span class="gms-chipcount">@(_counts?.All ?? 0)</span></button>
        <button type="button" class="gms-chipbtn @(_unreadOnly ? "on" : "")" aria-pressed="@(_unreadOnly ? "true" : "false")" @onclick="() => Select(null, true)">@L["Filter.Unread"] <span class="gms-chipcount">@(_counts?.Unread ?? 0)</span></button>
        @foreach (var category in Enum.GetValues<NotificationCategory>())
        {
            var on = _filter == category;
            <button type="button" class="gms-chipbtn @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => Select(category, false)">@L[$"Category.{category}"] <span class="gms-chipcount">@(_counts?.ByCategory.GetValueOrDefault(category) ?? 0)</span></button>
        }
    </div>

    <AsyncContent T="PagedResult<NotificationItem>" Key="@($"{_q}|{_filter}|{_unreadOnly}|{_page}|{_rev}")" Loader="LoadAsync" IsEmpty="r => r.TotalCount == 0">
        <EmptyContent>
            @if (HasFilter)
            {
                <EmptyState Title="@L["Page.EmptyFilter"]" ActionText="@L["Page.Reset"]" OnAction="Reset" />
            }
            else
            {
                <EmptyState Title="@L["Page.Empty"]" />
            }
        </EmptyContent>
        <ChildContent Context="result">
            <table class="gms-table" style="border:0;border-radius:0">
                <caption class="gms-sr-only">@L["Page.Title"]</caption>
                <thead><tr><th scope="col" style="width:24px"><span class="gms-sr-only">@L["Item.Unread"]</span></th><th scope="col">@L["Panel.Title"]</th><th scope="col">Kategori</th><th scope="col">Jenis</th><th scope="col">Waktu</th></tr></thead>
                <tbody>
                    @foreach (var item in result.Items)
                    {
                        var view = Text.For(item);
                        <tr class="@(item.IsRead ? "" : "gms-nrow-unread")" style="cursor:pointer" @onclick="() => OpenAsync(item)">
                            <td>@if (!item.IsRead) { <span class="gms-udot" style="margin:0" aria-hidden="true"></span><span class="gms-sr-only">@L["Item.Unread"]</span> }</td>
                            <td><div class="nt"><button type="button" class="gms-btn gms-btn-link" style="font-weight:inherit;padding:0;color:inherit;height:auto" @onclick="() => OpenAsync(item)" @onclick:stopPropagation="true">@view.Title</button></div><div class="gms-muted" style="font-size:12px">@view.Body</div></td>
                            <td>@L[$"Category.{item.Category}"]</td>
                            <td>@if (view.BadgeLabel is not null) { <span class="gms-tag @view.BadgeTone">@view.BadgeLabel</span> }</td>
                            <td class="gms-muted" style="white-space:nowrap"><time datetime="@item.CreatedAt.UtcDateTime.ToString("o")" title="@NotificationText.FormatDate(item.CreatedAt)">@Text.Relative(item.CreatedAt, Time.GetUtcNow())</time></td>
                        </tr>
                    }
                </tbody>
            </table>
            <PagerBar Page="@_page" PageSize="@PageSize" TotalCount="@result.TotalCount" PageChanged="p => _page = p" />
            <p class="gms-muted" style="font-size:12px;padding:0 var(--space-4) var(--space-3);margin:0">@string.Format(L["Page.Retention"].Value, 90)</p>
        </ChildContent>
    </AsyncContent>
</div>

@code {
    private const int PageSize = 25;

    [CascadingParameter] private TabContext? Tab { get; set; }

    private NotificationCounts? _counts;
    private string _q = string.Empty;
    private NotificationCategory? _filter;
    private bool _unreadOnly;
    private int _page = 1;
    private int _rev;

    private bool HasFilter => !string.IsNullOrWhiteSpace(_q) || _filter is not null || _unreadOnly;

    private IReadOnlyList<PageHeader.Crumb> Crumbs => [new PageHeader.Crumb("Beranda", "/"), new PageHeader.Crumb(L["Page.Title"].Value)];

    protected override async Task OnInitializedAsync() => await RefreshCountsAsync();

    private async Task RefreshCountsAsync() =>
        await Errors.RunAsync(async () => _counts = await Api.GetCountsAsync(string.IsNullOrWhiteSpace(_q) ? null : _q));

    private async Task<PagedResult<NotificationItem>> LoadAsync(CancellationToken ct)
    {
        return await Api.ListAsync(new NotificationListQuery
        {
            Page = _page, PageSize = PageSize, Q = string.IsNullOrWhiteSpace(_q) ? null : _q.Trim(), Category = _filter, Unread = _unreadOnly ? true : null,
        }, ct);
    }

    private async Task ApplySearch()
    {
        _page = 1;
        _rev++;
        await RefreshCountsAsync();
    }

    private void Select(NotificationCategory? category, bool unreadOnly)
    {
        _filter = category;
        _unreadOnly = unreadOnly;
        _page = 1;
    }

    private async Task Reset()
    {
        _q = string.Empty;
        _filter = null;
        _unreadOnly = false;
        _page = 1;
        _rev++;
        await RefreshCountsAsync();
    }

    private async Task OpenAsync(NotificationItem item)
    {
        if (!item.IsRead)
        {
            await Errors.RunAsync(async () => await Api.MarkReadAsync(item.Id));
        }

        Nav.NavigateTo(NotificationLinks.UrlFor(item.Target));
    }

    private async Task MarkAllAsync()
    {
        if (await Errors.RunAsync(async () => await Api.MarkAllReadAsync()) is null)
        {
            Toast.ShowSuccess(L["Panel.AllMarked"].Value);
            _rev++;
            await RefreshCountsAsync();
        }
    }
}
