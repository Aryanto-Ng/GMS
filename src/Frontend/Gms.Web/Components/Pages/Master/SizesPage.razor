@page "/master/sizes"
@attribute [Authorize(Policy = PermissionPolicyProvider.Prefix + Permissions.MasterData.Size.View)]
@inject ISizeApi Sizes
@inject IToastService Toasts

<PageTitle>Size · GMS</PageTitle>

<MasterList @ref="_list" TItem="SizeDto" Title="Size" Noun="size" Loader="Sizes.ListAsync" IsActive="d => d.IsActive" Label="d => d.Name"
            SetActive="ToggleAsync" CreatePermission="@Permissions.MasterData.Size.Create" EditPermission="@Permissions.MasterData.Size.Edit"
            DeactivatePermission="@Permissions.MasterData.Size.Deactivate" OnCreate="OpenCreate" OnEdit="OpenEdit">
    <Header><th scope="col" class="num">Urutan</th><th scope="col">Kode</th><th scope="col">Nama</th></Header>
    <Row Context="d"><td class="num">@d.SortOrder</td><th scope="row">@d.Code</th><td>@d.Name</td></Row>
</MasterList>

<ReasonDialog Open="_open" OpenChanged="o => _open = o" ShowReason="false" Danger="false" ConfirmText="Simpan" Title="@(_editing is null ? "Tambah size" : "Ubah size")"
              CanConfirm="@(!string.IsNullOrWhiteSpace(_code) && !string.IsNullOrWhiteSpace(_name) && int.TryParse(_order, out var o) && o >= 1)" OnConfirm="SaveAsync">
    <TextField Label="Kode" @bind-Value="_code" Required="true" MaxLength="10" />
    <TextField Label="Nama" @bind-Value="_name" Required="true" MaxLength="50" />
    <TextField Label="Urutan tampil" @bind-Value="_order" Required="true" MaxLength="4" InputMode="numeric" Hint="Menentukan urutan kolom Size pada semua grid (kecil ke besar)." />
</ReasonDialog>

@code {
    private MasterList<SizeDto>? _list;
    private bool _open;
    private SizeDto? _editing;
    private string? _code = string.Empty, _name = string.Empty, _order = "1";

    private void OpenCreate() { _editing = null; _code = _name = string.Empty; _order = "1"; _open = true; }

    private void OpenEdit(SizeDto d) { _editing = d; _code = d.Code; _name = d.Name; _order = d.SortOrder.ToString(); _open = true; }

    private async Task SaveAsync(string _)
    {
        var request = new SaveSizeRequest(_code!.Trim(), _name!.Trim(), int.Parse(_order!), _editing?.RowVersion ?? 0);
        if (_editing is null) { await Sizes.CreateAsync(request); } else { await Sizes.UpdateAsync(_editing.Id, request); }
        Toasts.ShowSuccess("Size disimpan.");
        _list?.Refresh();
    }

    private async Task ToggleAsync(SizeDto d, bool active)
    {
        await Sizes.SetActiveAsync(d.Id, active, (await Sizes.GetAsync(d.Id)).RowVersion);
        Toasts.ShowSuccess(active ? "Size diaktifkan." : "Size dinonaktifkan.");
    }
}
