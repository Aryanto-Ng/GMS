@inject ApiErrorHandler Errors
@inject IToastService Toasts

@* Master bentuk sederhana (Kode + Nama): Satuan dan Kategori Material. Form berupa dialog di atas daftar (MasterData-UI.md bagian 1). *@
<PageTitle>@Title · GMS</PageTitle>

<MasterList @ref="_list" TItem="SimpleMasterDto" Title="@Title" Noun="@Noun" Loader="Api.ListAsync" IsActive="d => d.IsActive" Label="d => d.Name"
            SetActive="ToggleAsync" CreatePermission="@CreatePermission" EditPermission="@EditPermission" DeactivatePermission="@DeactivatePermission"
            OnCreate="OpenCreate" OnEdit="OpenEdit">
    <Header>
        <th scope="col">Kode</th><th scope="col">Nama</th>
    </Header>
    <Row Context="d">
        <th scope="row">@d.Code</th><td>@d.Name</td>
    </Row>
</MasterList>

<ReasonDialog Open="_open" OpenChanged="o => _open = o" ShowReason="false" Danger="false" ConfirmText="Simpan"
              Title="@(_editing is null ? $"Tambah {Noun}" : $"Ubah {Noun}")" CanConfirm="@(!string.IsNullOrWhiteSpace(_code) && !string.IsNullOrWhiteSpace(_name))" OnConfirm="SaveAsync">
    <TextField Label="Kode" @bind-Value="_code" Required="true" MaxLength="30" />
    <TextField Label="Nama" @bind-Value="_name" Required="true" MaxLength="100" />
</ReasonDialog>

@code {
    private MasterList<SimpleMasterDto>? _list;
    private bool _open;
    private SimpleMasterDto? _editing;
    private string? _code = string.Empty, _name = string.Empty;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Noun { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IMasterCrudApi<SimpleMasterDto, SimpleMasterDto, SaveSimpleMasterRequest> Api { get; set; } = default!;

    [Parameter] public string? CreatePermission { get; set; }

    [Parameter] public string? EditPermission { get; set; }

    [Parameter] public string? DeactivatePermission { get; set; }

    private void OpenCreate()
    {
        _editing = null;
        _code = _name = string.Empty;
        _open = true;
    }

    private void OpenEdit(SimpleMasterDto item)
    {
        _editing = item;
        _code = item.Code;
        _name = item.Name;
        _open = true;
    }

    private async Task SaveAsync(string _)
    {
        var request = new SaveSimpleMasterRequest(_code!.Trim(), _name!.Trim(), _editing?.RowVersion ?? 0);
        if (_editing is null) { await Api.CreateAsync(request); } else { await Api.UpdateAsync(_editing.Id, request); }
        Toasts.ShowSuccess($"{Noun} disimpan.");
        _list?.Refresh();
    }

    private async Task ToggleAsync(SimpleMasterDto item, bool active)
    {
        var current = await Api.GetAsync(item.Id); // rowVersion terbaru
        await Api.SetActiveAsync(item.Id, active, current.RowVersion);
        Toasts.ShowSuccess(active ? $"{Noun} diaktifkan." : $"{Noun} dinonaktifkan.");
    }
}
