@page "/master/customers"
@attribute [Authorize(Policy = PermissionPolicyProvider.Prefix + Permissions.MasterData.Customer.View)]
@inject ICustomerApi Customers
@inject IGmsToast Toasts

<PageTitle>Customer · GMS</PageTitle>

<MasterList @ref="_list" TItem="CustomerDto" Title="Customer" Noun="customer" Loader="Customers.ListAsync" IsActive="d => d.IsActive" Label="d => d.Name"
            SetActive="ToggleAsync" CreatePermission="@Permissions.MasterData.Customer.Create" EditPermission="@Permissions.MasterData.Customer.Edit"
            DeactivatePermission="@Permissions.MasterData.Customer.Deactivate" OnCreate="OpenCreate" OnEdit="OpenEdit">
    <Header><th scope="col">Kode</th><th scope="col">Nama</th><th scope="col">Kontak</th><th scope="col">Telepon</th></Header>
    <Row Context="d"><th scope="row">@d.Code</th><td>@d.Name</td><td>@(d.ContactPerson ?? "—")</td><td>@(d.Phone ?? "—")</td></Row>
</MasterList>

<ConfirmDialog Open="_open" OpenChanged="o => _open = o" ShowReason="false" Danger="false" ConfirmText="Simpan" Title="@(_editing is null ? "Tambah customer" : $"Ubah {_editing.Code}")"
              CanConfirm="@(!string.IsNullOrWhiteSpace(_name))" OnConfirm="SaveAsync">
    <p class="gms-note">Kode: @(_editing?.Code ?? "Otomatis saat disimpan")</p>
    <TextField Label="Nama" @bind-Value="_name" Required="true" MaxLength="100" />
    <TextField Label="Kontak (PIC)" @bind-Value="_contact" MaxLength="100" />
    <TextField Label="Telepon" @bind-Value="_phone" MaxLength="30" Type="tel" />
    <TextField Label="Alamat" @bind-Value="_address" MaxLength="250" Multiline="true" />
    <TextField Label="Keterangan" @bind-Value="_notes" MaxLength="250" Multiline="true" />
</ConfirmDialog>

@code {
    private MasterList<CustomerDto>? _list;
    private bool _open;
    private CustomerDto? _editing;
    private string? _name = string.Empty, _contact, _phone, _address, _notes;

    private void OpenCreate() { _editing = null; _name = string.Empty; _contact = _phone = _address = _notes = null; _open = true; }

    private void OpenEdit(CustomerDto d) { _editing = d; _name = d.Name; _contact = d.ContactPerson; _phone = d.Phone; _address = d.Address; _notes = d.Notes; _open = true; }

    private static string? N(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task SaveAsync(string _)
    {
        var request = new SaveCustomerRequest(_name!.Trim(), N(_contact), N(_phone), N(_address), N(_notes), _editing?.RowVersion ?? 0);
        if (_editing is null) { await Customers.CreateAsync(request); } else { await Customers.UpdateAsync(_editing.Id, request); }
        Toasts.ShowSuccess("Customer disimpan.");
        _list?.Refresh();
    }

    private async Task ToggleAsync(CustomerDto d, bool active)
    {
        await Customers.SetActiveAsync(d.Id, active, (await Customers.GetAsync(d.Id)).RowVersion);
        Toasts.ShowSuccess(active ? "Customer diaktifkan." : "Customer dinonaktifkan.");
    }
}
