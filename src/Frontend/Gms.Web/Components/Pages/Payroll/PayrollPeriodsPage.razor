@page "/payroll"
@attribute [Authorize(Policy = PermissionPolicyProvider.Prefix + Permissions.Payroll.View)]
@inject IPayrollApi Payroll
@inject ApiErrorHandler Errors
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject IGmsToast Toasts

<PageTitle>Periode Gaji · GMS</PageTitle>

<PageHeader Title="Periode Gaji">
    <Actions>
        @if (_user.HasPermission(Permissions.Payroll.CreatePeriod)) { <span title="@(_defaults?.HasOpenPeriod == true ? "Sudah ada periode Open. Tutup lebih dulu." : null)"><GmsButton Type="@BtnKind.Primary" Disabled="@(_defaults?.HasOpenPeriod == true)" OnClick="OpenCreate">Buat Periode</GmsButton></span> }
    </Actions>
</PageHeader>

<AsyncContent T="IReadOnlyList<PayrollPeriodListItem>" Key="_defaults?.HasOpenPeriod" Loader="LoadAsync" IsEmpty="r => r.Count == 0">
    <EmptyContent>
        <EmptyState Title="Belum ada periode gaji" ActionText="@(_user.HasPermission(Permissions.Payroll.CreatePeriod) ? "Buat Periode" : null)" OnAction="OpenCreate" />
    </EmptyContent>
    <ChildContent Context="periods">
        @if (_defaults is { HasOpenPeriod: false, StartDate: { } next } && _user.HasPermission(Permissions.Payroll.CreatePeriod))
        {
            <MessageBar Kind="info">Belum ada periode terbuka. Mulai periode berikutnya mulai @IdFormat.Date(next).</MessageBar>
        }

        <table class="gms-table">
            <caption class="gms-sr-only">Daftar periode gaji</caption>
            <thead><tr><th scope="col">Kode</th><th scope="col">Rentang</th><th scope="col">Status</th><th scope="col" class="num">Pekerja</th><th scope="col" class="num">Total (Rp)</th><th scope="col">Ditutup</th></tr></thead>
            <tbody>
                @foreach (var p in periods)
                {
                    <tr>
                        <th scope="row"><a href="/payroll/@p.Id">@p.Code</a></th>
                        <td>@IdFormat.Date(p.StartDate) – @IdFormat.Date(p.EndDate)</td>
                        <td><StatusBadge Value="@p.Status" /> @if (p.IsProvisional) { <span class="gms-warn">Belum final</span> }</td>
                        <td class="num">@p.WorkerCount</td>
                        <td class="num">@IdFormat.Number(p.TotalPaid)@(p.IsProvisional ? " *" : string.Empty)</td>
                        <td>@(p.ClosedAt is null ? "–" : $"{IdFormat.DateTime(p.ClosedAt)} oleh {p.ClosedByName}")</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="gms-note">* sementara — BELUM FINAL</p>
    </ChildContent>
</AsyncContent>

<ConfirmDialog Open="_creating" OpenChanged="o => _creating = o" ShowReason="false" Danger="false" ConfirmText="Buat Periode" Title="Buat Periode Gaji"
              CanConfirm="@(DateOnly.TryParseExact(_end, "yyyy-MM-dd", out _) && (_defaults?.StartLocked == true || DateOnly.TryParseExact(_start, "yyyy-MM-dd", out _)))" OnConfirm="CreateAsync">
    <div class="gms-form">
        <TextField Label="Tanggal Mulai" Type="date" Value="@_start" ValueChanged="v => _start = v" Disabled="@(_defaults?.StartLocked == true)"
                   Hint="@(_defaults?.StartLocked == true ? "Terkunci — hari setelah periode sebelumnya." : _defaults?.OldestOutputDate is { } oldest ? $"Output tertua: {IdFormat.Date(oldest)}" : null)" />
        <TextField Label="Tanggal Selesai" Type="date" Value="@_end" ValueChanged="v => _end = v" Required="true" />
        <div class="gms-inline">
            <GmsButton Type="@BtnKind.Link" OnClick="() => Shortcut(7)">7 hari</GmsButton>
            <GmsButton Type="@BtnKind.Link" OnClick="() => Shortcut(14)">14 hari</GmsButton>
            <GmsButton Type="@BtnKind.Link" OnClick="MonthEnd">Akhir bulan</GmsButton>
        </div>
        <TextField Label="Catatan" Value="@_notes" ValueChanged="v => _notes = v" MaxLength="250" />
    </div>
</ConfirmDialog>

@code {
    private NextPeriodDefaultsDto? _defaults;
    private bool _creating;
    private string? _start, _end, _notes;
    private System.Security.Claims.ClaimsPrincipal _user = new();

    protected override async Task OnInitializedAsync()
    {
        _user = (await Auth.GetAuthenticationStateAsync()).User;
        await LoadDefaultsAsync();
    }

    private async Task LoadDefaultsAsync()
    {
        if (_user.HasPermission(Permissions.Payroll.CreatePeriod)) { await Errors.RunAsync(async () => _defaults = await Payroll.GetNextPeriodDefaultsAsync()); }
    }

    private async Task<IReadOnlyList<PayrollPeriodListItem>> LoadAsync(CancellationToken ct) => await Payroll.ListPeriodsAsync(ct);

    private async Task OpenCreate()
    {
        await LoadDefaultsAsync();
        _start = _defaults?.StartDate?.ToString("yyyy-MM-dd");
        _end = null;
        _notes = null;
        _creating = true;
    }

    private void Shortcut(int days)
    {
        if (DateOnly.TryParseExact(_start, "yyyy-MM-dd", out var s)) { _end = s.AddDays(days - 1).ToString("yyyy-MM-dd"); }
    }

    private void MonthEnd()
    {
        if (DateOnly.TryParseExact(_start, "yyyy-MM-dd", out var s)) { _end = new DateOnly(s.Year, s.Month, DateTime.DaysInMonth(s.Year, s.Month)).ToString("yyyy-MM-dd"); }
    }

    private async Task CreateAsync(string _)
    {
        DateOnly? start = DateOnly.TryParseExact(_start, "yyyy-MM-dd", out var s) ? s : null;
        var created = await Payroll.CreatePeriodAsync(new SavePeriodRequest(start, DateOnly.ParseExact(_end!, "yyyy-MM-dd"), string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()));
        Toasts.ShowSuccess($"Periode {created.Code} dibuat.");
        Nav.NavigateTo($"/payroll/{created.Id}");
    }
}
