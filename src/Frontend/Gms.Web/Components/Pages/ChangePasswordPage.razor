@page "/account/change-password"
@layout AccountLayout
@attribute [ExcludeFromInteractiveRouting]
@inject AuthenticationStateProvider Auth

<PageTitle>Ganti Password · GMS</PageTitle>

<h1 class="gms-account-title">Ganti Password</h1>

@if (_mustChange)
{
    <div class="gms-banner info" role="status">Anda harus mengganti password sebelum melanjutkan.</div>
}

@if (Message is { } message)
{
    <div class="gms-banner error" role="alert">@message</div>
}

<form method="post" action="/account/change-password" class="gms-form">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@AccountEndpoints.SafeReturnUrl(ReturnUrl)" />

    <label for="current">Password saat ini <span class="gms-required">wajib</span></label>
    <input id="current" name="CurrentPassword" type="password" autocomplete="current-password" required autofocus />

    <label for="new">Password baru <span class="gms-required">wajib</span></label>
    <input id="new" name="NewPassword" type="password" autocomplete="new-password" required minlength="8" aria-describedby="new-hint" />
    <small id="new-hint">Minimal 8 karakter, mengandung angka, dan berbeda dari password saat ini.</small>

    <label for="confirm">Ulangi password baru <span class="gms-required">wajib</span></label>
    <input id="confirm" name="ConfirmPassword" type="password" autocomplete="new-password" required />

    <button type="submit" class="gms-primary">Simpan password</button>
    @if (!_mustChange)
    {
        <a class="gms-secondary" href="@AccountEndpoints.SafeReturnUrl(ReturnUrl)">Batal</a>
    }
</form>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "message")] private string? ServerMessage { get; set; }

    private bool _mustChange;

    protected override async Task OnInitializedAsync() =>
        _mustChange = (await Auth.GetAuthenticationStateAsync()).User.MustChangePasswordNow();

    private string? Message => Error switch
    {
        null or "" => null,
        "required" => "Password saat ini dan password baru wajib diisi.",
        "mismatch" => "Konfirmasi password tidak sama dengan password baru.",
        "rejected" => string.IsNullOrWhiteSpace(ServerMessage) ? "Password ditolak. Periksa password saat ini dan aturan password baru." : ServerMessage,
        _ => "Terjadi kesalahan. Coba lagi.",
    };
}
