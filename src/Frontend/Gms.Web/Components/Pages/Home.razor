@page "/"
@inject AuthenticationStateProvider Auth
@inject IDashboardApi Dashboard

<PageTitle>Beranda · GMS</PageTitle>

@* Hero Beranda (Design.md 10): satu baris = sapaan, waktu pembaruan, chip ringkasan yang dapat diklik; Segarkan = ikon saja. Beranda tidak punya tombol primary. *@
<div class="gms-hero">
    <h1>Selamat datang, @_name</h1>
    <span class="when">Diperbarui @_updated</span>
    @foreach (var chip in _chips)
    {
        <a class="gms-herochip @chip.Tone" href="@chip.Href"><GmsIcon Name="@chip.Icon" Class="s12" />@chip.Text</a>
    }
    <span style="margin-left:auto"><GmsButton Type="@BtnKind.Default" Icon="refresh" AriaLabel="Segarkan Beranda" Title="Segarkan" OnClick="RefreshAsync" /></span>
</div>
<p class="gms-sr-only" role="status" aria-live="polite">@_announce</p>

@if (_quick.Count > 0)
{
    <section class="gms-card" role="region" aria-label="Aksi Cepat" style="padding:var(--space-3) 14px">
        <h3 class="gms-sr-only">Aksi Cepat</h3>
        <div class="gms-quick">
            @foreach (var (label, href) in _quick.Take(6)) { <a class="gms-btn gms-btn-default" href="@href"><GmsIcon Name="plus" />@label</a> }
        </div>
    </section>
}

@if (_widgetCount == 0)
{
    <EmptyState Title="Belum ada ringkasan untuk peran Anda" Description="Gunakan menu di bagian atas untuk membuka modul yang boleh Anda akses." />
}

@foreach (var area in _areas)
{
    <h2 class="gms-area">@area</h2>
    <div class="gms-dgrid">
        @switch (area)
        {
            case "Produksi":
                <DashboardCard T="OutputTodayWidget" Title="Output Hari Ini" Permission="@Permissions.ProductionOutput.View" Loader="Dashboard.GetOutputTodayAsync" Href="/production/history" Icon="chart" Refresh="_refresh" SizeClass="medium">
                    <p class="gms-big">@IdFormat.Qty(context.TotalQty) <small>pcs</small></p>
                    @if (context.TotalQty == 0) { <p class="gms-ok"><GmsIcon Name="check-circle" /> Belum ada output hari ini</p> }
                    @if (context.ByProcess.Count > 0) { <ChartBars AriaLabel="Output hari ini per proses" Rows="@(context.ByProcess.Select(p => new ChartBars.Row(p.ProcessName, p.Qty, "/production/history?hariIni=true")).ToList())" /> }
                </DashboardCard>
                <DashboardCard T="WoRunningWidget" Title="WO Berjalan" Permission="@Permissions.WorkOrder.View" Loader="Dashboard.GetWoRunningAsync" Href="/work-orders" Icon="task" Refresh="_refresh" SizeClass="wide">
                    <ChartStack AriaLabel="WO berjalan per status" Segments="@(new[] { new ChartStack.Seg("Released", context.Released, "--k1"), new ChartStack.Seg("In Progress", context.InProgress, "--k8"), new ChartStack.Seg("Completed", context.CompletedAwaitingClose, "--k5") })" />
                    <ul class="gms-wolist">
                        @foreach (var w in context.Items)
                        {
                            <li><a href="/work-orders/@w.Id">@w.Code</a> @w.FgCode
                                <span role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Min(100, (int)w.ProgressPercent)" aria-valuetext="@($"{IdFormat.Number(w.ProgressPercent, 1)} persen")" class="gms-pbar @(w.ProgressPercent >= 100 ? "done" : w.TargetDate is { } t && t < DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)) ? "late" : "prog")" style="display:inline-block;width:90px;vertical-align:middle"><i style="width:@Math.Min(100m, w.ProgressPercent)%"></i></span>
                                @IdFormat.Number(w.ProgressPercent, 1)% · Target @IdFormat.Date(w.TargetDate)</li>
                        }
                    </ul>
                </DashboardCard>
                <DashboardCard T="VendorBalanceWidget" Title="Sisa di Vendor" Permission="@Permissions.VendorJob.View" Loader="Dashboard.GetVendorBalanceAsync" Href="/production/history" Refresh="_refresh" SizeClass="small">
                    <p class="gms-big">@IdFormat.Qty(context.TotalQty) <small>pcs</small></p>
                    <ul>@foreach (var v in context.ByVendor) { <li>@v.VendorName @IdFormat.Qty(v.Qty)</li> }</ul>
                </DashboardCard>
                <DashboardCard T="UnhandedOverWidget" Title="Belum Diserahterimakan" Permission="@Permissions.SerahTerimaFG.View" Loader="Dashboard.GetUnhandedOverAsync" Href="/handovers/fg" Icon="box" Refresh="_refresh" SizeClass="wide">
                    <p class="gms-big">@IdFormat.Qty(context.TotalQty) <small>pcs</small></p>
                    @if (context.TotalQty == 0) { <p class="gms-ok"><GmsIcon Name="check-circle" /> Semua output sudah diserahterimakan</p> }
                    <ul>@foreach (var i in context.Items) { <li><a href="/work-orders/@i.WoId">@i.WoCode</a> · @IdFormat.Qty(i.Qty)</li> }</ul>
                </DashboardCard>
                <DashboardCard T="WoLateWidget" Title="WO Terlambat" Permission="@Permissions.WorkOrder.View" Loader="Dashboard.GetWoLateAsync" Href="/work-orders?terlambat=true" Refresh="_refresh" SizeClass="small">
                    @if (context.Count == 0) { <p class="gms-ok"><GmsIcon Name="check-circle" /> 0 WO terlambat</p> }
                    else { <p class="gms-big gms-bad"><GmsIcon Name="clock-circle" /> @context.Count WO terlambat</p> }
                </DashboardCard>
                break;
            case "Penjualan":
                <DashboardCard T="PoLateWidget" Title="PO Terlambat" Permission="@Permissions.CustomerPO.View" Loader="Dashboard.GetPoLateAsync" Href="/purchase-orders?terlambat=true" Icon="clock" Refresh="_refresh" SizeClass="medium">
                    @if (context.PoCount == 0) { <p class="gms-ok"><GmsIcon Name="check-circle" /> 0 PO terlambat</p> }
                    else { <p class="gms-big gms-bad"><GmsIcon Name="clock-circle" /> @context.PoCount PO terlambat · @IdFormat.Qty(context.ShortageQty) pcs</p> }
                    <ul>@foreach (var i in context.Items) { <li><a href="/purchase-orders/@i.PoId">@i.Code</a> @i.CustomerName −@(i.DaysLate)h</li> }</ul>
                </DashboardCard>
                <DashboardCard T="DueSoonWidget" Title="Jatuh Tempo 7 Hari" Permission="@Permissions.CustomerPO.View" Loader="Dashboard.GetDueSoonAsync" Href="/purchase-orders?jatuhTempo7=true" Refresh="_refresh" SizeClass="small">
                    <p class="gms-big">@context.PoCount PO · @IdFormat.Qty(context.Qty) pcs</p>
                </DashboardCard>
                <DashboardCard T="PoNoCustomerNumberWidget" Title="PO Belum Ada No. Customer" Permission="@Permissions.CustomerPO.View" Loader="Dashboard.GetPoNoCustomerNumberAsync" Href="/purchase-orders?poCustomerKosong=true" Refresh="_refresh" SizeClass="small">
                    @if (context.PoCount == 0) { <p class="gms-ok"><GmsIcon Name="check-circle" /> Semua PO punya nomor</p> }
                    else { <p class="gms-big gms-warn"><GmsIcon Name="warning" /> @context.PoCount PO</p> }
                </DashboardCard>
                <DashboardCard T="UnplannedDemandWidget" Title="Kebutuhan Belum Terencana" Permission="@Permissions.CustomerPO.View" Loader="Dashboard.GetUnplannedDemandAsync" Href="/purchase-orders?sisaRencana=true" Refresh="_refresh" SizeClass="small">
                    <p class="gms-big">@IdFormat.Qty(context.Qty) pcs · @context.PoCount PO</p>
                </DashboardCard>
                break;
            case "Gudang":
                <DashboardCard T="StockSummaryWidget" Title="Stok FG" Permission="@Permissions.StokFG.View" Loader="Dashboard.GetStockSummaryAsync" Href="/stock" Icon="box" Refresh="_refresh" SizeClass="wide">
                    <p class="gms-big">@IdFormat.Qty(context.OnHand) <small>pcs fisik</small></p>
                    <ChartStack AriaLabel="Stok FG: teralokasi dan tersedia" Segments="@(new[] { new ChartStack.Seg("Teralokasi", context.Allocated, "--k1"), new ChartStack.Seg("Tersedia", context.Available, "--k5") })" />
                    @if (context.TopFgs.Count > 0) { <ChartBars AriaLabel="Stok tersedia per FG" Rows="@(context.TopFgs.Select(f => new ChartBars.Row(f.FgCode, f.Available, "/stock")).ToList())" /> }
                </DashboardCard>
                break;
            case "Penggajian":
                <DashboardCard T="PayrollPeriodWidget" Title="Periode Gaji" Permission="@Permissions.Payroll.View" Loader="Dashboard.GetPayrollPeriodAsync" Href="/payroll" Icon="money" Refresh="_refresh" SizeClass="medium">
                    @if (!context.HasOpenPeriod)
                    {
                        <p>Belum ada periode terbuka.@(context.SuggestedNextStart is { } next ? $" Mulai periode berikutnya mulai {IdFormat.Date(next)}." : string.Empty)</p>
                        <a class="gms-btn gms-btn-default" href="/payroll">Buat Periode</a>
                    }
                    else
                    {
                        <p class="doc-number">@context.Code</p>
                        <div class="gms-inline"><StatusBadge Value="@PayrollStatus.Open" /><StatusBadge Value="@("provisional")" /></div>
                        <p>@context.WorkerCount pekerja · Rp @IdFormat.Number(context.ProvisionalTotal)* · sisa @context.DaysLeft hari</p>
                        <a class="gms-btn gms-btn-default" href="@($"/payroll/{context.PeriodId}")">Buka</a>
                    }
                </DashboardCard>
                break;
            default:
                <DashboardCard T="SecurityWidget" Title="Keamanan Akun" Permission="@Permissions.AccessManagement.AuditLog.View" Loader="Dashboard.GetSecurityAsync" Href="/admin/audit" Icon="shield" Refresh="_refresh" SizeClass="small">
                    <p><GmsIcon Name="lock" /> <strong>@context.LockedAccounts</strong> akun terkunci · <strong>@context.FailedLogins24h</strong> login gagal (24 jam)</p>
                    <a href="/admin/users">Lihat pengguna</a>
                </DashboardCard>
                break;
        }
    </div>
}

@code {
    private static readonly (string Area, string[] Permissions)[] AreaMap =
    [
        ("Produksi", [Gms.Shared.Security.Permissions.ProductionOutput.View, Gms.Shared.Security.Permissions.WorkOrder.View, Gms.Shared.Security.Permissions.VendorJob.View, Gms.Shared.Security.Permissions.SerahTerimaFG.View]),
        ("Penjualan", [Gms.Shared.Security.Permissions.CustomerPO.View]),
        ("Gudang", [Gms.Shared.Security.Permissions.StokFG.View]),
        ("Penggajian", [Gms.Shared.Security.Permissions.Payroll.View]),
        ("Administrasi", [Gms.Shared.Security.Permissions.AccessManagement.AuditLog.View]),
    ];

    private string _name = string.Empty, _updated = string.Empty, _announce = string.Empty;
    private List<string> _areas = [];
    private List<(string Label, string Href)> _quick = [];
    private int _widgetCount, _refresh;
    private List<(string Text, string Href, string Tone, string Icon)> _chips = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        _name = user.DisplayName();
        _updated = IdFormat.DateTime(DateTimeOffset.UtcNow);

        // Area paling relevan (paling banyak widget yang boleh dilihat) tampil lebih dahulu; area tanpa izin tidak ditampilkan.
        var scored = AreaMap.Select(a => (a.Area, Score: a.Permissions.Count(user.HasPermission))).Where(a => a.Score > 0).OrderByDescending(a => a.Score).ToList();
        _areas = scored.Select(a => a.Area).ToList();
        _widgetCount = scored.Sum(a => a.Score);
        _quick = new (string, string, string)[]
        {
            ("Input Output", "/production/output", Permissions.ProductionOutput.Create), ("Kirim/Terima Vendor", "/production/vendor", Permissions.VendorJob.Create),
            ("Serah Terima FG", "/handovers/fg/new", Permissions.SerahTerimaFG.Create), ("Serah Terima Material", "/handovers/material/new", Permissions.SerahTerimaMaterial.Create),
            ("Buat PO", "/purchase-orders/new", Permissions.CustomerPO.Create), ("Buat Surat Jalan", "/deliveries/new", Permissions.Pengiriman.Create),
            ("Buat WO", "/work-orders/new", Permissions.WorkOrder.Create),
        }.Where(q => user.HasPermission(q.Item3)).Select(q => (q.Item1, q.Item2)).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadChipsAsync();
        }
    }

    /// <summary>Chip ringkasan (keterlambatan, dll.) dari widget yang boleh dilihat; kegagalan diabaikan (kartu menampilkan galatnya sendiri).</summary>
    private async Task LoadChipsAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        var chips = new List<(string, string, string, string)>();
        try
        {
            if (user.HasPermission(Permissions.CustomerPO.View))
            {
                var late = await Dashboard.GetPoLateAsync(CancellationToken.None);
                if (late.PoCount > 0) { chips.Add(($"{late.PoCount} PO terlambat", "/purchase-orders?terlambat=true", "t-err", "clock")); }
                var none = await Dashboard.GetPoNoCustomerNumberAsync(CancellationToken.None);
                if (none.PoCount > 0) { chips.Add(($"{none.PoCount} PO belum ada No. Customer", "/purchase-orders?poCustomerKosong=true", "t-warn", "alert")); }
            }

            if (user.HasPermission(Permissions.WorkOrder.View))
            {
                var wo = await Dashboard.GetWoLateAsync(CancellationToken.None);
                if (wo.Count > 0) { chips.Add(($"{wo.Count} WO terlambat", "/work-orders?terlambat=true", "t-err", "clock")); }
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or TaskCanceledException)
        {
            // ringkasan bersifat tambahan
        }

        _chips = chips;
        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        _refresh++;
        _updated = IdFormat.DateTime(DateTimeOffset.UtcNow);
        _announce = "Beranda diperbarui";
        await Task.CompletedTask;
    }
}
