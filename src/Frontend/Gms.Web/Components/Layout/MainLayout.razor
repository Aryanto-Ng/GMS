@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject TabManager Tabs
@inject IStringLocalizer<ChromeResource> L

@* Layout 4 zona (Design.md 3): Global Header, Top Navigation, Internal Tab Manager, Main Workspace. Tanpa sidebar. Router menentukan halaman untuk URL aktif;
   isi halaman dirender oleh TabHost (semua tab terbuka tetap hidup). @Body sengaja tidak dirender. *@

<a class="gms-skip" href="#gms-main">@L["Skip.Main"]</a>

<div class="gms-app">
    <AppHeader Catalog="_catalog" OnToggleNav="() => _navOpen = !_navOpen" />
    <TopNav Catalog="_catalog" Open="_navOpen" OnNavigate="() => _navOpen = false" />
    <TabBar />
    <main id="gms-main" tabindex="-1" class="gms-main">
        @if (Tabs.LimitReached)
        {
            <div class="gms-banner warning" role="status">
                <GmsIcon Name="alert" />
                <div class="gms-banner-body">@string.Format(L["Tabs.Limit"].Value, TabManager.MaxTabs)</div>
                <button type="button" class="gms-banner-close" aria-label="@L["Tabs.CloseMessage"]" @onclick="Tabs.DismissLimit"><GmsIcon Name="dismiss" /></button>
            </div>
        }

        <TabHost />
        <div class="gms-footer">@string.Format(L["Footer.Text"].Value, Identity.Year, Identity.Name)</div>
    </main>
</div>

<ToastHost />

@code {
    [CascadingParameter] private RouteData? RouteData { get; set; }

    [Inject] private IOptions<AppIdentityOptions> IdentityOptions { get; set; } = default!;

    private AppIdentityOptions Identity => IdentityOptions.Value;
    private IReadOnlyList<NavCategory> _catalog = [];
    private bool _navOpen;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        _catalog = NavCatalog.VisibleFor(user.HasPermission);
        Tabs.EnsureHome(typeof(Pages.Home));
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        if (RouteData is not null)
        {
            Tabs.Sync(RouteData.PageType, RouteData.RouteValues, Nav.Uri);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _navOpen = false;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
