# Production: salin menjadi deploy/prod/.env di server (JANGAN di-commit). Isi semua nilai.
DOMAIN=gms.contoh.com
ACME_EMAIL=admin@contoh.com
IMAGE_TAG=latest

# Database. Bare machine: PROD_DB_HOST=172.17.0.1 (IP gateway host). Docker: PROD_DB_HOST=db dan jalankan dengan --profile with-db
PROD_DB_HOST=172.17.0.1
PROD_DB_PORT=5432
PROD_DB_NAME=gms
PROD_DB_USER=gms
PROD_DB_PASSWORD=ganti-dengan-password-acak-panjang

# Password awal akun "admin" (wajib diganti saat login pertama)
PROD_ADMIN_BOOTSTRAP_PASSWORD=ganti-dengan-password-awal-unik

# Kop dokumen (surat jalan / slip gaji)
COMFI_NAME=
COMFI_ADDRESS=
KONVEKSI_NAME=
KONVEKSI_ADDRESS=

# Backup off-site (S3-kompatibel, mis. Cloudflare R2)
PROD_S3_PROVIDER=Cloudflare
PROD_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
PROD_S3_BUCKET=gms-backup
PROD_S3_ACCESS_KEY=
PROD_S3_SECRET_KEY=
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
