# Salin menjadi deploy/.env di server (JANGAN di-commit). Isi semua nilai.
DOMAIN=gms.contoh.com
ACME_EMAIL=admin@contoh.com
IMAGE_TAG=latest

# Database
DB_PASSWORD=ganti-dengan-password-acak-panjang

# Password awal akun "admin" (wajib diganti saat login pertama)
ADMIN_BOOTSTRAP_PASSWORD=ganti-dengan-password-awal-unik

# Kop dokumen (surat jalan / slip gaji)
COMFI_NAME=
COMFI_ADDRESS=
KONVEKSI_NAME=
KONVEKSI_ADDRESS=

# Backup off-site (S3-kompatibel, mis. Cloudflare R2)
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=gms-backup
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
